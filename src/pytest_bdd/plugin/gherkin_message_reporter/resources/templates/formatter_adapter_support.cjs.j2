'use strict';

const path = require('node:path');

function resolvePrettyPrinterClass() {
  const imported = require('@cucumber/pretty-formatter');
  const candidates = [
    imported && imported.PrettyPrinter,
    imported && imported.default && imported.default.PrettyPrinter,
    imported && imported.default,
    imported && imported.default && imported.default.default,
  ];
  for (const candidate of candidates) {
    if (typeof candidate === 'function') {
      return candidate;
    }
  }
  throw new Error('Unable to resolve @cucumber/pretty-formatter PrettyPrinter class.');
}

function resolveSummaryFormatterClass() {
  const imported = require('@cucumber/cucumber/lib/formatter/summary_formatter');
  const candidates = [imported && imported.default, imported];
  for (const candidate of candidates) {
    if (typeof candidate === 'function') {
      return candidate;
    }
  }
  throw new Error('Unable to resolve @cucumber/cucumber summary formatter class.');
}

function requireCucumberDependency(moduleName) {
  const cucumberRoot = path.dirname(require.resolve('@cucumber/cucumber/package.json'));
  return require(require.resolve(moduleName, { paths: [cucumberRoot] }));
}

function requireCucumberInternalModule(relativePath) {
  const cucumberRoot = path.dirname(require.resolve('@cucumber/cucumber/package.json'));
  return require(path.join(cucumberRoot, 'lib', relativePath));
}

const PROGRESS_CHARACTER_MAPPING = new Map([
  ['AMBIGUOUS', 'A'],
  ['FAILED', 'F'],
  ['PASSED', '.'],
  ['PENDING', 'P'],
  ['SKIPPED', '-'],
  ['UNDEFINED', 'U'],
  ['UNKNOWN', '?'],
]);

const PROGRESS_STATUS_SEVERITY = new Map([
  ['FAILED', 60],
  ['AMBIGUOUS', 50],
  ['UNDEFINED', 40],
  ['PENDING', 30],
  ['SKIPPED', 20],
  ['PASSED', 10],
  ['UNKNOWN', 0],
]);

function normalizeProgressStatus(status) {
  return String(status || 'UNKNOWN').toUpperCase();
}

function selectWorseProgressStatus(currentStatus, nextStatus) {
  const currentSeverity = PROGRESS_STATUS_SEVERITY.get(normalizeProgressStatus(currentStatus)) || 0;
  const nextSeverity = PROGRESS_STATUS_SEVERITY.get(normalizeProgressStatus(nextStatus)) || 0;
  return nextSeverity >= currentSeverity ? normalizeProgressStatus(nextStatus) : normalizeProgressStatus(currentStatus);
}

function formatProgressCharacter(summaryFormatter, status) {
  const normalizedStatus = normalizeProgressStatus(status);
  const character = PROGRESS_CHARACTER_MAPPING.get(normalizedStatus) || '?';
  return summaryFormatter.colorFns.forStatus(normalizedStatus)(character);
}

function fitUsageFormatterColumnWidths(stream, rows) {
  const terminalColumns = Number.isFinite(stream.columns) ? stream.columns : 0;
  if (!stream.isTTY || terminalColumns < 48) {
    return null;
  }

  const stringWidth = requireCucumberDependency('string-width');
  const measureLines = (lines) =>
    lines.reduce((maxWidth, line) => Math.max(maxWidth, stringWidth(String(line))), 0);
  const usableWidth = Math.max(terminalColumns - 4, 44);
  const minPatternWidth = 20;
  const minDurationWidth = 10;
  const maxDurationWidth = 14;
  const minLocationWidth = 18;
  const patternWanted = rows.reduce(
    (maxWidth, row) => Math.max(maxWidth, measureLines(row.col1)),
    stringWidth('Pattern / Text'),
  );
  const durationWanted = rows.reduce(
    (maxWidth, row) => Math.max(maxWidth, measureLines(row.col2)),
    stringWidth('Duration'),
  );
  let durationWidth = Math.min(Math.max(durationWanted, minDurationWidth), maxDurationWidth);
  let patternWidth = Math.min(
    Math.max(patternWanted, minPatternWidth),
    Math.max(usableWidth - durationWidth - minLocationWidth, minPatternWidth),
  );
  let locationWidth = usableWidth - durationWidth - patternWidth;
  if (locationWidth < minLocationWidth) {
    const deficit = minLocationWidth - locationWidth;
    const reclaimedFromPattern = Math.min(deficit, Math.max(patternWidth - minPatternWidth, 0));
    patternWidth -= reclaimedFromPattern;
    locationWidth += reclaimedFromPattern;
  }
  return [patternWidth, durationWidth, locationWidth];
}

function resolveJUnitXmlPrinterClass() {
  const imported = require('@cucumber/junit-xml-formatter');
  const candidates = [
    imported && imported.JUnitXmlPrinter,
    imported && imported.default && imported.default.JUnitXmlPrinter,
  ];
  for (const candidate of candidates) {
    if (typeof candidate === 'function') {
      return candidate;
    }
  }
  throw new Error('Unable to resolve @cucumber/junit-xml-formatter JUnitXmlPrinter class.');
}

module.exports = {
  fitUsageFormatterColumnWidths,
  formatProgressCharacter,
  normalizeProgressStatus,
  requireCucumberDependency,
  requireCucumberInternalModule,
  resolveJUnitXmlPrinterClass,
  resolvePrettyPrinterClass,
  resolveSummaryFormatterClass,
  selectWorseProgressStatus,
};
