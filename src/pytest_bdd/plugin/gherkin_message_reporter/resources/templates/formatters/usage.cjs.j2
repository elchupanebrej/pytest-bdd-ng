'use strict';

const {
  fitUsageFormatterColumnWidths,
  requireCucumberDependency,
  requireCucumberInternalModule,
} = require('./support.cjs');

class UsageFormatterAdapter {
  constructor(options) {
    this.eventDataCollector = options.eventDataCollector;
    this.log = options.log;
    this.stream = options.stream;
    this.supportCodeLibrary = options.supportCodeLibrary;
    options.eventBroadcaster.on('envelope', (envelope) => {
      if (envelope.testRunFinished) {
        this.logUsage();
      }
    });
  }

  logUsage() {
    const Table = requireCucumberDependency('cli-table3');
    const cucumberMessages = requireCucumberDependency('@cucumber/messages');
    const formatterHelpers = requireCucumberInternalModule('formatter/helpers/index.js');
    const usage = formatterHelpers.getUsage({
      stepDefinitions: this.supportCodeLibrary.stepDefinitions,
      eventDataCollector: this.eventDataCollector,
    });
    if (usage.length === 0) {
      this.log('No step definitions');
      return;
    }

    const rows = usage.map(({ line, matches, meanDuration, pattern, patternType, uri }) => {
      let formattedPattern = pattern;
      if (patternType === 'RegularExpression') {
        formattedPattern = '/' + formattedPattern + '/';
      }
      const col1 = [formattedPattern];
      const col2 = [];
      if (matches.length > 0) {
        if (meanDuration) {
          col2.push(`${cucumberMessages.TimeConversion.durationToMilliseconds(meanDuration).toFixed(2)}ms`);
        } else {
          col2.push('-');
        }
      } else {
        col2.push('UNUSED');
      }
      const col3 = [formatterHelpers.formatLocation({ line, uri })];
      matches.slice(0, 5).forEach((match) => {
        col1.push(`  ${match.text}`);
        if (match.duration) {
          col2.push(`${cucumberMessages.TimeConversion.durationToMilliseconds(match.duration).toFixed(2)}ms`);
        } else {
          col2.push('-');
        }
        col3.push(formatterHelpers.formatLocation(match));
      });
      if (matches.length > 5) {
        col1.push(`  ${(matches.length - 5).toString()} more`);
      }
      return { col1, col2, col3 };
    });
    const tableOptions = {
      head: ['Pattern / Text', 'Duration', 'Location'],
      style: {
        border: [],
        head: [],
      },
    };
    const colWidths = fitUsageFormatterColumnWidths(this.stream, rows);
    if (colWidths) {
      tableOptions.colWidths = colWidths;
      tableOptions.wordWrap = true;
    }
    const table = new Table(tableOptions);

    rows.forEach(({ col1, col2, col3 }) => {
      table.push([col1.join('\n'), col2.join('\n'), col3.join('\n')]);
    });

    this.log(`${table.toString()}\n`);
  }

  finished() {
    return Promise.resolve();
  }
}

module.exports = UsageFormatterAdapter;
