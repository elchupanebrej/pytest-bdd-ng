'use strict';

const {
  formatProgressCharacter,
  resolveSummaryFormatterClass,
  selectWorseProgressStatus,
} = require('./support.cjs');

class ProgressBarFormatterAdapter {
  constructor(options) {
    this.pickleIds = new Set();
    this.testCaseIds = new Set();
    this.testCaseIdsByStartedId = new Map();
    this.pickleIdsByTestCaseId = new Map();
    this.pickleIdsByStartedId = new Map();
    this.completedPickleIds = new Set();
    this.completedScenarioCount = 0;
    this.attemptStatuses = new Map();
    this.stream = options.stream;
    options.eventBroadcaster.on('envelope', (envelope) => {
      if (envelope.pickle && envelope.pickle.id) {
        this.pickleIds.add(String(envelope.pickle.id));
      } else if (envelope.testCase && envelope.testCase.id) {
        const testCaseId = String(envelope.testCase.id);
        this.testCaseIds.add(testCaseId);
        if (envelope.testCase.pickleId) {
          const pickleId = String(envelope.testCase.pickleId);
          this.pickleIds.add(pickleId);
          this.pickleIdsByTestCaseId.set(testCaseId, pickleId);
        }
      } else if (envelope.testCaseStarted && envelope.testCaseStarted.id) {
        const attemptId = String(envelope.testCaseStarted.id);
        this.attemptStatuses.set(attemptId, 'UNKNOWN');
        if (envelope.testCaseStarted.testCaseId) {
          const testCaseId = String(envelope.testCaseStarted.testCaseId);
          this.testCaseIdsByStartedId.set(attemptId, testCaseId);
          const pickleId = this.pickleIdsByTestCaseId.get(testCaseId);
          if (pickleId) {
            this.pickleIdsByStartedId.set(attemptId, pickleId);
          }
        }
      } else if (envelope.testStepFinished && envelope.testStepFinished.testCaseStartedId) {
        const attemptId = String(envelope.testStepFinished.testCaseStartedId);
        const status = envelope.testStepFinished.testStepResult && envelope.testStepFinished.testStepResult.status;
        this.attemptStatuses.set(
          attemptId,
          selectWorseProgressStatus(this.attemptStatuses.get(attemptId), status),
        );
      } else if (envelope.testCaseFinished && envelope.testCaseFinished.testCaseStartedId) {
        const attemptId = String(envelope.testCaseFinished.testCaseStartedId);
        const status = this.attemptStatuses.get(attemptId) || 'UNKNOWN';
        this.completedScenarioCount += 1;
        const pickleId = this.pickleIdsByStartedId.get(attemptId);
        if (pickleId) {
          this.completedPickleIds.add(pickleId);
        }
        if (this.stream.isTTY) {
          this.renderProgressBar(status);
        } else {
          this.stream.write(formatProgressCharacter(this.summaryFormatter, status));
        }
      } else if (envelope.testRunFinished) {
        this.stream.write('\n\n');
      }
    });
    const SummaryFormatter = resolveSummaryFormatterClass();
    this.summaryFormatter = new SummaryFormatter(options);
  }

  renderProgressBar(status) {
    const total = Math.max(this.pickleIds.size, this.testCaseIds.size, 1);
    const completed = Math.min(
      this.completedPickleIds.size > 0 ? this.completedPickleIds.size : this.completedScenarioCount,
      total,
    );
    const ratio = Math.min(completed / total, 1);
    const prefix = `${completed}/${total} scenarios `;
    const suffix = ` ${formatProgressCharacter(this.summaryFormatter, status)}`;
    const availableWidth = Math.max((this.stream.columns || 80) - prefix.length - suffix.length - 3, 10);
    const completedWidth = Math.round(availableWidth * ratio);
    const bar = `${'#'.repeat(completedWidth)}${'-'.repeat(Math.max(availableWidth - completedWidth, 0))}`;
    if (typeof this.stream.cursorTo === 'function') {
      this.stream.cursorTo(0);
    }
    this.stream.write(`${prefix}[${bar}]${suffix}`);
    if (typeof this.stream.clearLine === 'function') {
      this.stream.clearLine(1);
    }
  }

  finished() {
    return Promise.resolve();
  }
}

module.exports = ProgressBarFormatterAdapter;
