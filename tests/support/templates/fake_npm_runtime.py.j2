#!/usr/bin/env python3
import json
import os
import sys
from pathlib import Path


def _package_dir(root, package_name):
    return Path(root).joinpath(*package_name.split("/"))


def _install(packages, root):
    root.mkdir(parents=True, exist_ok=True)
    for package_name in packages:
        package_dir = _package_dir(root, package_name)
        package_dir.mkdir(parents=True, exist_ok=True)
        (package_dir / "package.json").write_text(
            json.dumps({"name": package_name, "version": "0.0.0-test"}),
            encoding="utf-8",
        )
    return 0


def _list_package(package_name):
    global_root = Path(os.environ["FAKE_GLOBAL_NODE_MODULES_ROOT"])
    return 0 if _package_dir(global_root, package_name).exists() else 1


def main():
    args = sys.argv[1:]
    if not args:
        raise SystemExit(1)
    if args == ["--version"]:
        sys.stdout.write("10.0.0-test\n")
        raise SystemExit(0)
    if args == ["root"] or args == ["root", "--silent"]:
        sys.stdout.write(f"{Path.cwd() / 'node_modules'}\n")
        raise SystemExit(0)
    if args == ["root", "-g"] or args == ["-g", "root"]:
        sys.stdout.write(f"{Path(os.environ['FAKE_GLOBAL_NODE_MODULES_ROOT'])}\n")
        raise SystemExit(0)
    if args and args[0] == "list":
        packages = [arg for arg in args[1:] if not arg.startswith("-")]
        if not packages:
            raise SystemExit(0)
        raise SystemExit(_list_package(packages[-1]))
    if args and args[0] == "install":
        global_install = "-g" in args
        packages = [arg for arg in args[1:] if not arg.startswith("-")]
        if global_install:
            raise SystemExit(_install(packages, Path(os.environ["FAKE_GLOBAL_NODE_MODULES_ROOT"])))
        raise SystemExit(_install(packages, Path.cwd() / "node_modules"))
    raise SystemExit(0)


if __name__ == "__main__":
    main()
