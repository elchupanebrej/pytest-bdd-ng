[run]
branch = true
source = pytest_bdd
omit =
    # Pylint checker bridge: exercised through focused checker unit tests, not product runtime.
    */_pylint/*
    # Optional Go parser bridge: native/shared-library path has platform-specific coverage, Python fallback remains in measured core.
    */_gherkin_go/*
    # Developer scripts: command-line maintenance tools, not package runtime.
    */script/*
    # Test support package: helper library for tests, not shipped runtime logic.
    */testing/*
    # Plugin entrypoint glue: pytest loads indirectly; behavior covered through plugin modules.
    */entrypoint.py
    # Code generator plugin: optional scaffolding workflow, verified by generator tests.
    */plugin/code_generator/*
    # Cucumber formatter adapters: optional formatter integrations covered by formatter suites.
    */plugin/cucumber_*/*
    # Debug MCP plugin: interactive debugging integration, not normal test runtime.
    */plugin/debug_mcp/*
    # Gherkin message reporter: optional live reporting stack covered by integration/e2e suites.
    */plugin/gherkin_message_reporter/*
    # Terminal reporter compatibility path: optional reporter integration.
    */plugin/gherkin_terminal_reporter/*
    # Structured BDD plugin: optional parser/plugin surface covered by struct-bdd tests.
    */plugin/struct_bdd/*
    # Formatter support utilities: optional formatter registry/standalone helpers.
    */util/cucumber_formatter_support/*
    # Formatter discovery utility: optional formatter bridge helper.
    */util/cucumber_formatters.py
    # Live reporting utility: optional process/reporting helper.
    */util/live_reporting.py
    # Test matrix utility: environment enumeration helper, not runtime behavior.
    */util/matrix.py
    # Node resource helper: optional external formatter dependency resolver.
    */util/npm_resource.py
    # Temporary-root helper: environment/file-system support utility.
    */util/temp_root.py
    # Webloc helper: platform-specific URL shortcut support.
    */util/webloc.py

[report]
fail_under = 70
show_missing = true
omit =
    # Pylint checker bridge: exercised through focused checker unit tests, not product runtime.
    */_pylint/*
    # Optional Go parser bridge: native/shared-library path has platform-specific coverage, Python fallback remains in measured core.
    */_gherkin_go/*
    # Developer scripts: command-line maintenance tools, not package runtime.
    */script/*
    # Test support package: helper library for tests, not shipped runtime logic.
    */testing/*
    # Plugin entrypoint glue: pytest loads indirectly; behavior covered through plugin modules.
    */entrypoint.py
    # Code generator plugin: optional scaffolding workflow, verified by generator tests.
    */plugin/code_generator/*
    # Cucumber formatter adapters: optional formatter integrations covered by formatter suites.
    */plugin/cucumber_*/*
    # Debug MCP plugin: interactive debugging integration, not normal test runtime.
    */plugin/debug_mcp/*
    # Gherkin message reporter: optional live reporting stack covered by integration/e2e suites.
    */plugin/gherkin_message_reporter/*
    # Terminal reporter compatibility path: optional reporter integration.
    */plugin/gherkin_terminal_reporter/*
    # Structured BDD plugin: optional parser/plugin surface covered by struct-bdd tests.
    */plugin/struct_bdd/*
    # Formatter support utilities: optional formatter registry/standalone helpers.
    */util/cucumber_formatter_support/*
    # Formatter discovery utility: optional formatter bridge helper.
    */util/cucumber_formatters.py
    # Live reporting utility: optional process/reporting helper.
    */util/live_reporting.py
    # Test matrix utility: environment enumeration helper, not runtime behavior.
    */util/matrix.py
    # Node resource helper: optional external formatter dependency resolver.
    */util/npm_resource.py
    # Temporary-root helper: environment/file-system support utility.
    */util/temp_root.py
    # Webloc helper: platform-specific URL shortcut support.
    */util/webloc.py
