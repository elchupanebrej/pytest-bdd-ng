{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pytest-bdd-ng.local/contracts/governance-report.schema.json",
  "title": "Messages Capability Governance Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "generated_at",
    "baseline_release",
    "summary",
    "capabilities"
  ],
  "properties": {
    "version": {
      "type": "string",
      "enum": [
        "1.1"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "baseline_release": {
      "type": "string"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_capabilities",
        "implemented_capabilities",
        "blocked_capabilities",
        "deferred_capabilities",
        "coverage_percentage",
        "runtime_required_total",
        "runtime_required_covered",
        "runtime_required_missing",
        "non_runtime_required_total",
        "non_runtime_covered",
        "non_runtime_classified",
        "mandatory_scope_violations"
      ],
      "properties": {
        "total_capabilities": {
          "type": "integer",
          "minimum": 0
        },
        "implemented_capabilities": {
          "type": "integer",
          "minimum": 0
        },
        "blocked_capabilities": {
          "type": "integer",
          "minimum": 0
        },
        "deferred_capabilities": {
          "type": "integer",
          "minimum": 0
        },
        "coverage_percentage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "runtime_required_total": {
          "type": "integer",
          "minimum": 0
        },
        "runtime_required_covered": {
          "type": "integer",
          "minimum": 0
        },
        "runtime_required_missing": {
          "type": "integer",
          "minimum": 0
        },
        "non_runtime_required_total": {
          "type": "integer",
          "minimum": 0
        },
        "non_runtime_covered": {
          "type": "integer",
          "minimum": 0
        },
        "non_runtime_classified": {
          "type": "integer",
          "minimum": 0
        },
        "mandatory_scope_violations": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability_id",
          "status",
          "disposition",
          "mandatory_scope",
          "runtime_required",
          "observed_runtime"
        ],
        "properties": {
          "capability_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "Implemented",
              "Partly-Applicable",
              "Pending",
              "Non-Implementable",
              "Not-Applicable",
              "Not-Acceptable"
            ]
          },
          "disposition": {
            "type": "string",
            "enum": [
              "approved",
              "blocked",
              "deferred"
            ]
          },
          "mandatory_scope": {
            "type": "boolean"
          },
          "runtime_required": {
            "type": "boolean"
          },
          "observed_runtime": {
            "type": "boolean"
          },
          "rationale": {
            "type": "string",
            "description": "Decision rationale. For Partly-Applicable this must explain language/runtime model mismatch. For Non-Implementable this must describe an objective hard technical limitation."
          },
          "hard_limitation": {
            "type": "string",
            "description": "Explicit hard technical limitation statement for objectively unreachable runtime capabilities."
          },
          "decision_owner": {
            "type": "string"
          },
          "reviewed_at": {
            "type": "string",
            "format": "date-time"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "open_risk": {
            "type": "string"
          },
          "recheck_trigger": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "Partly-Applicable",
                    "Pending",
                    "Non-Implementable",
                    "Not-Applicable",
                    "Not-Acceptable"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "rationale",
                "decision_owner",
                "reviewed_at",
                "evidence_refs"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "Non-Implementable"
                }
              }
            },
            "then": {
              "required": [
                "hard_limitation",
                "recheck_trigger"
              ]
            }
          }
        ]
      }
    }
  }
}
